# vim: set ft=zsh:

# Login shells only, before zshrc. PATH, tool configuration, and anything slow;
# exports here are inherited by every child process.

typeset -U PATH path

# Homebrew
# this does: eval "$(/opt/homebrew/bin/brew shellenv)"
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
[ -n "${MANPATH-}" ] && export MANPATH=":${MANPATH#:}"
export MANPATH="/opt/homebrew/share/man:${MANPATH:-}"

# Tool config
export HOMEBREW_BAT=1
export HOMEBREW_BUNDLE_FILE_PATH="$DOTFILES/Brewfile"
export HOMEBREW_DOWNLOAD_CONCURRENCY="auto"
export HOMEBREW_CASK_OPTS="--fontdir=~/Library/Fonts"
export HOMEBREW_DISPLAY_INSTALL_TIMES=1
export HOMEBREW_NO_ANALYTICS=1
export BAT_CONFIG_PATH="$DOTFILES/home/batconfig"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"
export STARSHIP_LOG="error"
export NAVI_PATH="$DOTFILES/home/doc"
export NEXTWORD_DATA_PATH="$HOME/.config/nextword-data"
export BOB_CONFIG="$HOME/.config/bob/config.json"

# App-specific
export OPENCODE_DISABLE_SHARE="true"
export NEOVIDE_FRAME="transparent"
export NEOVIDE_FORK=1
export GF_BRANCH_SKIP_REMOTE_BRANCHES="yes"
export QMK_HOME="$HOME/code/qmk/qmk_firmware"
export DICT_DEV_KIT_BIN="$HOME/code/Dictionary Development Kit/bin/build_dict.sh"

# Compiler/linker flags (icu4c, openssl@3)
export PKG_CONFIG_PATH="/opt/homebrew/opt/icu4c/lib/pkgconfig:/opt/homebrew/opt/openssl@3/lib/pkgconfig"
export LDFLAGS="-L/opt/homebrew/opt/icu4c/lib -L/opt/homebrew/opt/openssl@3/lib"
export CPPFLAGS="-I/opt/homebrew/opt/icu4c/include -I/opt/homebrew/opt/openssl@3/include"

# PATH (guarded — only add dirs that exist)
for d (
    $HOME/.local/share/bob/nvim-bin
    $HOME_DIR/zsh/bin
    $HOME/.local/bin
    $HOME/go/bin
    $HOME/.opencode/bin
    $HOME/Library/pnpm/bin
    $HOME/.spicetify
    $HOME/.yarn/bin
    $HOME/.cargo/bin
    $HOME/.bun/bin
    $HOME/.agentmemory/bin) {
    [[ -d $d ]] && path=($d $path)
}

# After PATH: nvim may come from bob's nvim-bin
if (( ${+commands[nvim]} )); then
    export VISUAL='nvim'
else
    export VISUAL='vim'
fi
export EDITOR="$VISUAL"
export GIT_EDITOR="$VISUAL"

export PRIVATE_FILE="$HOME/.zsh/private/private.zsh"
for f in ~/.zsh/private/*.zsh(N); do
    [ -e "$f" ] && source $f || break
done

# Equivalent of `rbenv init -` (~60 ms) minus its per-login `rbenv rehash`:
# rbenv's gem-rehash hook and `rbenv install` already rehash. The `rbenv`
# shell wrapper is interactive-only and lives in zsh/ruby.sh.
if (( ${+commands[rbenv]} )); then
    path=($HOME/.rbenv/shims $path)
    export RBENV_SHELL=zsh
fi
