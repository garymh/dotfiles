# vi: ft=gitconfig sw=2

[core]
  excludesfile   = ~/code/dotfiles/home/gitignore_global
  whitespace     = space-before-tab,-indent-with-non-tab,trailing-space
  editor         = nvim
  fsmonitor      = true
  untrackedCache = true
  preloadIndex   = true
	pager = hunk pager --no-line-numbers --wrap --no-hunk-headers --tab-width 2

[alias]
  amend                 = commit -a --amend
  back-to-origin        = !git reset --hard origin/`git symbolic-ref --short HEAD`
  delete-local-branch   = branch -D
  remove-local-branch   = branch -D
  rename-local-branch   = branch -m
  git                   = !exec git
  remotes               = remote -v
  set-upstream          = !git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`
  sha                   = rev-parse HEAD
  stashes               = stash list
  uncommit              = reset --mixed HEAD~
  unstage               = restore --staged
  ours                  = "!f() { git co --ours $@ && git add $@; }; f"
  theirs                = "!f() { git co --theirs $@ && git add $@; }; f"

[include]
  path = ~/.gitconfig.local

[includeIf "gitdir:~/code/work/"]
  path = ~/.gitconfig.work

[init]
  defaultBranch = main

[fetch]
  prune            = true
  writeCommitGraph = true
  pruneTags        = true

[push]
  default         = current
  autoSetupRemote = true

[pull]
  ff     = only
  rebase = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm      = histogram
  colorMoved     = zebra
  mnemonicPrefix = true

[rebase]
  autoStash         = true
  autosquash        = true
  instructionFormat = %<|(120) %s (%ar) <%an>
  updateRefs        = true

[rerere]
  enabled    = true
  autoupdate = true

[stash]
  showIncludeUntracked = true

[commit]
  template = commit-msg

[apply]
  whitespace = nowarn

[gc]
  reflogExpire            = 200
  reflogExpireUnreachable = 90

[column]
  ui = auto

[log]
  date = relative

[advice]
  detachedHead       = false
  pushNonFastForward = false

[features]
  manyfiles = true

[help]
  autocorrect = 1

[url "git@github.com:"]
  insteadOf = https://github.com/

[url "git@gitlab.com:"]
  insteadOf = https://gitlab.com/
