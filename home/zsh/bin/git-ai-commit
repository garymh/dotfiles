#!/usr/bin/env bash
set -euo pipefail

PROMPT='Generate a concise git commit message for these staged changes. Output ONLY the raw commit message with no markdown, no code blocks, no backticks, no explanations.'
if [ -f .git/commit-msg ] && grep -q 'Changelog:' .git/commit-msg; then
    PROMPT="$PROMPT Use GitLab commit style with a Changelog trailer (e.g. 'Changelog: fixed' or 'Changelog: added'). Valid values: added, fixed, changed, deprecated, removed, security, performance, other."
else
    PROMPT="$PROMPT Use conventional commit format."
fi

# Stat overview + diff without minified/lock files, capped so huge staged
# changes (vendored bundles etc.) stay well inside the model's context.
MAX_DIFF_BYTES=100000
git diff --staged -- ':!*.min.*' ':!*.lock' ':!package-lock.json' ':!pnpm-lock.yaml' > /tmp/staged_diff.full
{
    git diff --staged --stat
    echo
    head -c "$MAX_DIFF_BYTES" /tmp/staged_diff.full
    if [ "$(wc -c < /tmp/staged_diff.full)" -gt "$MAX_DIFF_BYTES" ]; then
        printf '\n[diff truncated at %s bytes; see stat above for all files]\n' "$MAX_DIFF_BYTES"
    fi
} > /tmp/staged_diff.patch

# Ephemeral, tool-less, single-shot run on a cheap Copilot model (gpt-4.1: 128K
# context, included in the Copilot subscription). stdin is closed because omp -p
# blocks forever on an inherited open pipe (git hooks, lazygit, scripts).
# omp can exit 0 with empty output on API errors, so check the output too.
if ! /Users/gary/.bun/bin/omp -p \
    --no-session --no-title --no-tools --no-lsp --no-skills --no-rules --no-extensions \
    --model github-copilot/gpt-4.1 --thinking off \
    --system-prompt 'You write git commit messages.' \
    "$PROMPT" @/tmp/staged_diff.patch < /dev/null > /tmp/commit_msg 2> /tmp/commit_msg.err ||
    [ ! -s /tmp/commit_msg ]; then
    echo "omp produced no commit message (see ~/.omp/logs/http-400-requests for API errors):" >&2
    cat /tmp/commit_msg.err >&2
fi

git commit -e -F /tmp/commit_msg
