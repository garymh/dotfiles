# vim: set filetype=ghostty :

custom-shader = shaders/cursor_blaze_no_trail.glsl

keybind = super+d=new_split:down
keybind = super+shift+d=new_split:right
keybind = cmd+shift+t=undo
keybind = global:cmd+f12=toggle_quick_terminal
# nvim hardcodes <C-i> == <Tab> internally (neovim/neovim#14400), so no terminal
# protocol can disambiguate them for nvim; send an unused control byte instead
# and map it directly in nvim's mappings.lua (<C-_>).
keybind = ctrl+i=text:\x1f

background-blur-radius            = 10
background-opacity                = 0.95
clipboard-read                    = allow
confirm-close-surface             = false
cursor-opacity                    = 0.5
macos-option-as-alt               = true
progress-style                    = true
quick-terminal-animation-duration = 0.1
quick-terminal-position           = right
quick-terminal-size               = 45%,50%
shell-integration-features        = cursor,title,sudo,path
window-padding-x                  = 10
window-theme                      = system
window-vsync                      = false

theme       = Vague
font-family = Input Mono Compressed

font-size             = 25
font-thicken-strength = 255
font-thicken          = false
font-feature          = -calt
font-feature          = -dlig
font-feature          = -liga
font-feature          = cv03
font-feature          = cv04
font-feature          = ss05
font-feature          = zero

adjust-cell-height    = 0%
adjust-cell-width     = 0%

config-file = ?auto/theme.ghostty
