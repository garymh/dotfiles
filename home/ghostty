# vim: set filetype=ghostty :

custom-shader = shaders/cursor_blaze_no_trail.glsl

keybind = super+d=new_split:down
keybind = super+shift+d=new_split:right
keybind = cmd+shift+t=undo

keybind = global:cmd+f12=toggle_quick_terminal

clipboard-read                    = allow
confirm-close-surface             = false
cursor-opacity                    = 0.5
progress-style                    = true
quick-terminal-animation-duration = 0.1
quick-terminal-position           = right
quick-terminal-size               = 45%,50%
shell-integration-features        = ssh-env,ssh-terminfo,cursor,title,sudo,path
window-padding-x                  = 10
window-theme                      = system
window-vsync                      = false

theme       = Vague
font-family = luculent

font-size             = 22
font-thicken-strength = 55
font-thicken          = true
font-feature          = -calt
font-feature          = -dlig
font-feature          = -liga
font-feature          = cv03
font-feature          = cv04
font-feature          = ss05
font-feature          = zero

adjust-cell-height    = 5%
adjust-cell-width     = 3%
