# vim: set filetype=ghostty :

custom-shader = shaders/cursor_blaze_no_trail.glsl

keybind = cmd+d=new_split:down
keybind = cmd+shift+d=new_split:right
keybind = cmd+shift+t=undo
keybind = ctrl+t=toggle_command_palette
# lets try this

keybind = global:cmd+f12=toggle_quick_terminal
# nvim hardcodes <C-i> == <Tab> internally (neovim/neovim#14400), so no terminal
# protocol can disambiguate them for nvim; send an unused control byte instead
# and map it directly in nvim's mappings.lua (<C-_>).
keybind = ctrl+i=text:\x1f

background-blur-radius            = 10
background-opacity                = 0.99
clipboard-read                    = allow
confirm-close-surface             = false
cursor-opacity                    = 0.5
macos-option-as-alt               = true
progress-style                    = true
quick-terminal-animation-duration = 0.1
quick-terminal-position           = right
quick-terminal-size               = 45%,50%
shell-integration-features        = cursor,title,sudo,path
window-padding-x                  = 10
window-theme                      = system
window-vsync                      = false

adjust-underline-position  = -2
adjust-underline-thickness = -10

font-family           = DispatchMono
font-size             = 18
font-thicken-strength = 255
font-thicken          = false
font-feature          = -calt  # disable contextual alternates (prevents automatic glyph substitutions)
font-feature          = -dlig  # disable discretionary ligatures (e.g. stylistic ligature pairs)
font-feature          = -liga  # disable standard ligatures (e.g. fi, fl, ffi)
font-feature          = ss05   # enable stylistic set 05 (alternate glyph forms)
font-feature          = ss02   # enable stylistic set 02 (alternate glyph forms)
font-feature          = zero   # enable slashed/zero glyph (distinguishes 0 from O)
font-feature          = onum   # enable old-style (non-lining) numerals
# font-feature          = cv03   # (commented) character variant 03 — alternate glyph forms
# font-feature          = cv04   # (commented) character variant 04 — alternate glyph forms

adjust-cell-height    = 0%
adjust-cell-width     = 0%

config-file = ?auto/theme.ghostty
