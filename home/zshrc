# vim: set ft=zsh:

# Interactive shells only. Aliases, functions, history, plugins, completion,
# prompt, key bindings. Environment belongs in zshenv/zprofile.

typeset -F4 SECONDS=0

source $DOTFILES/home/zsh/misc/utility.zsh

# every interactive shell, incl. non-TTY `zsh -i` from agents
# aliases, functions, history

for f (
    $DOTFILES/home/zsh/commands.sh
    $DOTFILES/home/zsh/git.sh
    $DOTFILES/home/zsh/golang.sh
    $DOTFILES/home/zsh/update.sh
    $DOTFILES/home/zsh/overload.sh) {
    source $f
}

command -v ruby > /dev/null 2>&1 && source $DOTFILES/home/zsh/ruby.sh

HISTFILE="$HOME/.zsh_history"
SAVEHIST=1000000
HISTSIZE=1000000

setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_FIND_NO_DUPS
setopt SHARE_HISTORY

hash -d dotfiles=~/code/dotfiles

# tty only
# plugins, completions, keybindings, fzf, prompt — skip for agents/scripts

if [[ -t 0 ]] && [[ -t 1 ]]; then

    # pre-zim plugin config (must be set before zim sources plugins)

    source $DOTFILES/home/zsh/ysu_ignored.sh

    export YSU_MODE=ALL
    # TODO: export YSU_HARDCORE_ALIASES=("gs" "ll" "gco")

    source $DOTFILES/home/zsh/zim.sh

    # post-zim config
    source $DOTFILES/home/zsh/fzf.sh
    source $DOTFILES/home/zsh/bindkeys.sh
    source $DOTFILES/home/zsh/_after_zsh.sh

    setopt ALWAYS_TO_END
    COMPLETION_WAITING_DOTS="true"
    setopt AUTO_MENU
    setopt COMPLETE_IN_WORD

    setopt CORRECT
    SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '
    WORDCHARS=${WORDCHARS//[\/]}

    unsetopt CORRECT_ALL
    unsetopt FLOWCONTROL

    autoload -U select-word-style
    select-word-style bash

    export GPG_TTY=$TTY

    export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
    zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'

    _zsh_cache="$HOME/.cache/zsh"
    _dir_exists $_zsh_cache || mkdir -p $_zsh_cache

    if (( ${+commands[carapace]} )); then
        [[ $_zsh_cache/carapace.zsh -nt ${commands[carapace]} ]] || carapace _carapace >| $_zsh_cache/carapace.zsh
        source $_zsh_cache/carapace.zsh
        _go_completion_cache="$_zsh_cache/go.zsh"
        [[ $_go_completion_cache -nt ${commands[carapace]} ]] || carapace go zsh >| $_go_completion_cache
        source $_go_completion_cache
        _go_completion_with_files() {
            if [[ ${words[2]} == run && ${words[CURRENT]} != -* ]]; then
                _files -g '*.go(-.)'
            else
                _go_completion
            fi
        }
        compdef _go_completion_with_files go
    elif (( ${+functions[compdef]} )); then
        compdef _go go
    fi

    if _exists vivid; then
        [[ $_zsh_cache/vivid_colors.zsh -nt ${commands[vivid]} ]] || vivid generate molokai >| $_zsh_cache/vivid_colors.zsh
        export LS_COLORS="$(< $_zsh_cache/vivid_colors.zsh)"
    fi

    source ~/.orbstack/shell/init.zsh 2>/dev/null || :
fi
